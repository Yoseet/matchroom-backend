# Copy this file to `.env` and fill in your local values.
# Never commit the real `.env`.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=matchroom
DB_SSL=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

# Authentication (generate your own with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_REFRESH_TTL_SECONDS=604800

# Account security
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
# Development only: returns the reset token in the API response.
AUTH_RETURN_RESET_TOKEN=false

# Legal documents
LEGAL_TERMS_VERSION=2026-11
LEGAL_PRIVACY_VERSION=2026-11

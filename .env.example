# Copia este archivo como .env y ajusta los valores locales.
# Nunca subas .env al repositorio.

NODE_ENV=development
PORT=3000
# Orígenes explícitos separados por coma. Nunca uses "*" con cookies.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=matchroom
DB_SSL=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

# Sesión
SESSION_COOKIE_NAME=matchroom_session
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
APP_PUBLIC_URL=http://localhost:5173

# Google (opcional). Sin este valor /auth/google responde 503.
GOOGLE_CLIENT_ID=

# Correo (opcional). Sin SMTP, los enlaces de verificación y recuperación se
# escriben en la consola del backend en desarrollo. En producción es obligatorio.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
